# Copy this file to .env and fill in real values. Never commit .env.

# --- ASR (Stage 1) ---
# One of these depending on which provider is wired up
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- App config ---
# Comma-separated origins allowed to hit the live translation endpoint
ALLOWED_ORIGINS=http://localhost:3000

# Requests per minute per client for the live audio/translation endpoint
RATE_LIMIT_PER_MINUTE=60

# Max characters accepted per ASR text chunk before it's rejected/truncated
MAX_INPUT_CHARS=1000

# --- Environment ---
# development | production
ENV=development
LOG_LEVEL=info
