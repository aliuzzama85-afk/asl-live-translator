# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is optional: the defaults work for local development.

# --- ASR (Stage 1) ---
# v1 uses the browser's Web Speech API, which needs no key. These are only
# for a future streaming-provider adapter (pipeline/STAGE1_2_PLAN.md).
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Gloss server (pipeline/gloss_server.py) ---
# Model checkpoint to serve; relative paths resolve against the repo root.
# checkpoints_v2 is the signed-off model (gloss_model/config.py's own default
# still points at the older v1 checkpoint).
GLOSS_CHECKPOINT_DIR=gloss_model/checkpoints_v2
# Port on 127.0.0.1. frontend/vite.config.js proxies /api/* here and reads the
# same variable.
GLOSS_SERVER_PORT=8765

# Comma-separated origins allowed to call the gloss server (the Vite dev
# server's own origin; requests with any other Origin header get 403).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute per client for the gloss server.
RATE_LIMIT_PER_MINUTE=60

# (No MAX_INPUT_CHARS here: the input cap is gloss_model/inference.py's
# MAX_INPUT_CHARS = 500, the single source of truth. A second, looser value
# here would only cause confusion.)

# --- Environment ---
# development | production
ENV=development
LOG_LEVEL=info
